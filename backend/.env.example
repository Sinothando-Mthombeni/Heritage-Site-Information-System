# Copy this file to .env and fill in values before running.
# .env is gitignored — never commit real secrets.

# Django
SECRET_KEY=replace-with-a-long-random-string-at-least-50-chars
DEBUG=False

# PostgreSQL
# Docker mode:  DB_HOST=postgres  DB_PORT=5432
# Local dev:    DB_HOST=localhost  DB_PORT=5432 (or 5433 if remapped)
DB_NAME=heritage_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgres-password
DB_HOST=postgres
DB_PORT=5432

# MongoDB
# Docker mode:  MONGO_URI=mongodb://mongo:27017/
# Atlas (prod): MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/
MONGO_URI=mongodb://mongo:27017/
MONGO_DB_NAME=heritage_phase3

# Production (Render sets RENDER_EXTERNAL_HOSTNAME automatically)
ALLOWED_HOSTS=localhost,127.0.0.1
